<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Benchmark.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Benchmark.UI.Views.ProcessSelectionView"
             x:DataType="vm:ProcessSelectionViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="24">

      <!-- ── Page header ─────────────────────────────────────────── -->
      <StackPanel Spacing="4">
        <TextBlock Text="Process Setup"
                   FontSize="24" FontWeight="Bold" Foreground="#E2E2F0"/>
        <TextBlock Text="Select two processes to compare side-by-side."
                   FontSize="13" Foreground="#8888AA"/>
      </StackPanel>

      <!-- ── Refresh + status ────────────────────────────────────── -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Command="{Binding RefreshProcessesCommand}"
                Classes="ActionButton">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="↻" FontSize="14"/>
            <TextBlock Text="Refresh"/>
          </StackPanel>
        </Button>

        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   Margin="12,0"
                   Foreground="#8888AA" FontSize="12"/>

        <ProgressBar Grid.Column="2"
                     IsVisible="{Binding IsLoading}"
                     IsIndeterminate="True"
                     Width="120" Height="4"/>
      </Grid>

      <!-- ── Two-column process pickers ──────────────────────────── -->
      <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,*">

        <!-- ── Process A ────────────────────────────────────── -->
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="Application A"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="#4FC3F7"/>

          <!-- Search bar -->
          <TextBox Text="{Binding SearchTextA}"
                   Watermark="Filter processes…"
                   Classes="SearchBox"/>

          <!-- Process list -->
          <Border Classes="Card" Height="280">
            <ListBox ItemsSource="{Binding FilteredProcessesA}"
                     SelectedItem="{Binding SelectedProcessA}"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12" Foreground="#E2E2F0"/>
                    <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}"
                               FontSize="10" Foreground="#666688"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Selected indicator -->
          <TextBlock FontSize="12" Foreground="#4FC3F7">
            <TextBlock.Text>
              <MultiBinding StringFormat="Selected: {0}">
                <Binding Path="SelectedProcessA" TargetNullValue="(none)"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>

          <!-- Browse button -->
          <Button Command="{Binding BrowseExecutableACommand}"
                  Classes="SecondaryButton">
            Browse Executable…
          </Button>
        </StackPanel>

        <!-- ── Divider ────────────────────────────────────────── -->
        <Border Grid.Column="1"
                Width="1"
                Background="#333355"
                VerticalAlignment="Stretch"/>

        <!-- ── Process B ────────────────────────────────────── -->
        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Text="Application B"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="#FFB74D"/>

          <TextBox Text="{Binding SearchTextB}"
                   Watermark="Filter processes…"
                   Classes="SearchBox"/>

          <Border Classes="Card" Height="280">
            <ListBox ItemsSource="{Binding FilteredProcessesB}"
                     SelectedItem="{Binding SelectedProcessB}"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12" Foreground="#E2E2F0"/>
                    <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}"
                               FontSize="10" Foreground="#666688"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <TextBlock FontSize="12" Foreground="#FFB74D">
            <TextBlock.Text>
              <MultiBinding StringFormat="Selected: {0}">
                <Binding Path="SelectedProcessB" TargetNullValue="(none)"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>

          <Button Command="{Binding BrowseExecutableBCommand}"
                  Classes="SecondaryButton">
            Browse Executable…
          </Button>
        </StackPanel>

      </Grid>

      <!-- ── Start button ────────────────────────────────────────── -->
      <Button Command="{Binding StartBenchmarkCommand}"
              HorizontalAlignment="Center"
              Classes="PrimaryButton"
              Width="280" Height="44">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="▶" FontSize="16"/>
          <TextBlock Text="Start Benchmark Session" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>
      </Button>

    </StackPanel>
  </ScrollViewer>

</UserControl>
